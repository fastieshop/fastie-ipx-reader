{
  "manifest_version": 3,
  "name": "IP Koruma Kodu Okuyucu - IP Rating Reader",
  "version": "1.0.0",
  "description": "IPX4, IPX7 ve IP67 gibi toz/su koruma kodlarını Türkçe ve İngilizce açıklayan çevrimdışı araç.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "IP Kodu Okuyucu"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ip-rating-reader@fastieshop.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
